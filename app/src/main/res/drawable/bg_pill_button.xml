<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="@color/pill_bg_focused" />
            <stroke
                android:width="1.5dp"
                android:color="@color/accent_violet" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="@color/pill_bg" />
            <stroke
                android:width="1dp"
                android:color="@color/pill_stroke" />
        </shape>
    </item>
</selector>