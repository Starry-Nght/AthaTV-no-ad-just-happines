<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:angle="90"
                android:startColor="#46357B"
                android:endColor="#2E2452"
                android:type="linear" />
            <stroke
                android:width="2dp"
                android:color="@color/accent_violet" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="@color/bg_card" />
            <stroke
                android:width="1dp"
                android:color="@color/bg_card_stroke" />
        </shape>
    </item>
</selector>