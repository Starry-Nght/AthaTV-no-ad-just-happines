<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="520dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:orientation="vertical"
    android:padding="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.1"
        android:text="ATHSTV PREFERENCES"
        android:textColor="@color/accent_violet"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="System &amp; Launcher Settings"
        android:textColor="@color/text_white"
        android:textSize="20sp"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="20dp"
        android:background="#22FFFFFF" />

    <!-- Open Android TV Settings -->
    <LinearLayout
        android:id="@+id/btnOpenAndroidSettings"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_pill_button"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_settings"
            android:tint="@color/text_white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:text="Open TV Device Settings"
            android:textColor="@color/text_white"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Reload Apps -->
    <LinearLayout
        android:id="@+id/btnRefreshApps"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_pill_button"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_apps"
            android:tint="@color/text_white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:text="Reload Installed Apps"
            android:textColor="@color/text_white"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Close Dialog -->
    <LinearLayout
        android:id="@+id/btnCloseSettings"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:background="@drawable/bg_pill_button"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Back to Home"
            android:textColor="@color/text_muted"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/dialogDeviceInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="20dp"
        android:text="ATHSTV v1.0 • Xiaomi Mi TV Stick"
        android:textColor="@color/text_hint"
        android:textSize="11sp" />

</LinearLayout>